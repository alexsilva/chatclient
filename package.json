{
  "name": "chatclient",
  "version": "1.0.1",
  "description": "Linux-friendly multi-provider desktop client for ChatGPT and Grok",
  "main": "main.js",
  "author": {
    "name": "Stephan Coertzen",
    "email": "coertzen.jfs@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "releaseNotes": {
    "fromHash": "28cf9a9"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "preview": "node scripts/serve-renderer.js",
    "build:linux": "electron-builder --linux --publish never",
    "release:linux": "npm run build:linux"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.local.chatclient",
    "productName": "ChatClient",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "injections/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "executableName": "chatclient",
      "maintainer": "Stephan Coertzen <coertzen.jfs@gmail.com>",
      "category": "Utility"
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "libayatana-appindicator3-1 | libappindicator3-1"
      ]
    }
  }
}
